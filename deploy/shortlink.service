[Unit]
Description=Anythingen Shortlink
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/anythingen-shortlink
EnvironmentFile=/opt/anythingen-shortlink/.env
ExecStart=/opt/anythingen-shortlink/venv/bin/gunicorn --workers 2 --bind 127.0.0.1:5000 app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
